{
  "buildCommand": "npm run build",
  "outputDirectory": "jvf_viewer/dist",
  "installCommand": "npm install --ignore-scripts=false",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "cz-dtm-utils.vercel.app"
        }
      ],
      "destination": "https://superjvf.cz/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.superjvf.cz"
        }
      ],
      "destination": "https://superjvf.cz/:path",
      "permanent": true
    },
    {
      "source": "/jvf_viewer",
      "has": [
        {
          "type": "query",
          "key": "mode",
          "value": "udm"
        }
      ],
      "destination": "/udm",
      "statusCode": 301
    },
    {
      "source": "/jvf_viewer/",
      "has": [
        {
          "type": "query",
          "key": "mode",
          "value": "udm"
        }
      ],
      "destination": "/udm",
      "statusCode": 301
    },
    {
      "source": "/jvf_viewer",
      "has": [
        {
          "type": "query",
          "key": "mode",
          "value": "jzm"
        }
      ],
      "destination": "/jzm",
      "statusCode": 301
    },
    {
      "source": "/jvf_viewer/",
      "has": [
        {
          "type": "query",
          "key": "mode",
          "value": "jzm"
        }
      ],
      "destination": "/jzm",
      "statusCode": 301
    },
    {
      "source": "/jvf_viewer",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/jvf_viewer/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/jvf_viewer/:path+",
      "destination": "/:path+",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/udm",
      "destination": "/index.html"
    },
    {
      "source": "/udm/",
      "destination": "/index.html"
    },
    {
      "source": "/jzm",
      "destination": "/index.html"
    },
    {
      "source": "/jzm/",
      "destination": "/index.html"
    },
    {
      "source": "/analytics",
      "destination": "/analytics.html"
    },
    {
      "source": "/analytics/",
      "destination": "/analytics.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/about/",
      "destination": "/about.html"
    }
  ]
}
