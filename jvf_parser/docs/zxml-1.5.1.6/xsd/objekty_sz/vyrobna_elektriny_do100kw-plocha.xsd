            <xs:documentation>Zařazení objektu do obsahové části dle metodiky SŽ</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ZaznamyObjektu">
          <xs:annotation>
            <xs:documentation>Jednotlivé záznamy daného objektu</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="vedpkwp:ZaznamObjektu" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ZaznamObjektu" abstract="true"/>
  <xs:element name="ZaznamObjektuRefN" type="vedpkwp:RefN" substitutionGroup="vedpkwp:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuIns" type="vedpkwp:Ins" substitutionGroup="vedpkwp:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuUpd" type="vedpkwp:Upd" substitutionGroup="vedpkwp:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuDel" type="vedpkwp:Del" substitutionGroup="vedpkwp:ZaznamObjektu"/>
