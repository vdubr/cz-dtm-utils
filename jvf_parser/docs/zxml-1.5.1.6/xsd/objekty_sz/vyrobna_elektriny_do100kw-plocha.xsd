            <xs:element name="SpolecneAtributyObjektuZDTSZ" type="atrsz:SpolecneAtributyObjektuZDTSZDelType" minOccurs="0"/>
            <xs:element ref="atr:TypVyrobnyElektriny" minOccurs="0"/>
            <xs:element ref="atr:InstalovanyVykon" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuPlocha3DDTIType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
