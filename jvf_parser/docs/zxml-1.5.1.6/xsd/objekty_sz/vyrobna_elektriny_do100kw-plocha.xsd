<?xml version="1.0" encoding="UTF-8"?>
<xs:schema elementFormDefault="qualified" xmlns:atr="atr" xmlns:atrsz="atrsz" xmlns:cmn="cmn" xmlns:gml="http://www.opengis.net/gml/3.2" targetNamespace="vedpkwp" xmlns:vedpkwp="vedpkwp" xmlns:xs="http://www.w3.org/2001/XMLSchema">
