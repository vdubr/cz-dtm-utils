<?xml version="1.0" encoding="UTF-8"?>
<xs:schema elementFormDefault="qualified" xmlns:atr="atr" xmlns:atrsz="atrsz" xmlns:cmn="cmn" xmlns:gml="http://www.opengis.net/gml/3.2" targetNamespace="sonda" xmlns:sonda="sonda" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:import schemaLocation="../common/atributy.xsd" namespace="atr"/>
  <xs:import schemaLocation="../common/atributy_sz.xsd" namespace="atrsz"/>
  <xs:import schemaLocation="../common/common.xsd" namespace="cmn"/>
  <xs:import schemaLocation="../ext/gml/gml.xsd" namespace="http://www.opengis.net/gml/3.2"/>
  <xs:element name="Sonda" type="sonda:SondaType"/>
  <xs:complexType name="SondaType">
    <xs:sequence>
      <xs:element name="ObjektovyKod" type="xs:string" fixed="100537"/>
      <xs:element name="ObjektovyTypNazev" fixed="Sonda">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="code_base" type="xs:string" fixed="9990000537" use="required"/>
              <xs:attribute name="code_suffix" type="xs:string" fixed="01" use="required"/>
              <xs:attribute name="dim" type="xs:integer" fixed="3" use="prohibited"/>
              <xs:attribute name="gia" type="xs:boolean" fixed="0" use="prohibited"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
      <xs:sequence>
        <xs:element name="KategorieObjektu" type="xs:string" fixed="Součásti a příslušenství staveb">
          <xs:annotation>
            <xs:documentation>Kategorie objektu dle metodiky SŽ</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="SkupinaObjektu" type="xs:string" fixed="Stavba společná pro více skupin">
          <xs:annotation>
            <xs:documentation>Skupina objektu dle metodiky SŽ</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ObsahovaCast" type="xs:string" fixed="ODSZ">
          <xs:annotation>
            <xs:documentation>Zařazení objektu do obsahové části dle metodiky SŽ</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ZaznamyObjektu">
          <xs:annotation>
            <xs:documentation>Jednotlivé záznamy daného objektu</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="sonda:ZaznamObjektu" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ZaznamObjektu" abstract="true"/>
  <xs:element name="ZaznamObjektuRefN" type="sonda:RefN" substitutionGroup="sonda:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuIns" type="sonda:Ins" substitutionGroup="sonda:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuUpd" type="sonda:Upd" substitutionGroup="sonda:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuDel" type="sonda:Del" substitutionGroup="sonda:ZaznamObjektu"/>
  <xs:complexType name="RefN">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuRefNType"/>
            <xs:element name="SpolecneAtributyObjektuODSZSZ" type="atrsz:SpolecneAtributyObjektuODSZSZRefNType"/>
            <xs:element ref="atrsz:Natoceni"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuBod3DType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Ins">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuInsType" minOccurs="0"/>
            <xs:element name="SpolecneAtributyObjektuODSZSZ" type="atrsz:SpolecneAtributyObjektuODSZSZInsType"/>
            <xs:element ref="atrsz:Natoceni"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuBod3DType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Upd">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuUpdType"/>
            <xs:element name="SpolecneAtributyObjektuODSZSZ" type="atrsz:SpolecneAtributyObjektuODSZSZUpdType" minOccurs="0"/>
            <xs:element ref="atrsz:Natoceni" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuBod3DType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Del">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuDelType"/>
            <xs:element name="SpolecneAtributyObjektuODSZSZ" type="atrsz:SpolecneAtributyObjektuODSZSZDelType" minOccurs="0"/>
            <xs:element ref="atrsz:Natoceni" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuBod3DType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
