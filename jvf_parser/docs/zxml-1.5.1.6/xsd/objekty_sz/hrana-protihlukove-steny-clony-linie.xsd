  <xs:element name="ZaznamObjektu" abstract="true"/>
  <xs:element name="ZaznamObjektuRefN" type="hraprohlusteclo:RefN" substitutionGroup="hraprohlusteclo:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuIns" type="hraprohlusteclo:Ins" substitutionGroup="hraprohlusteclo:ZaznamObjektu"/>
