<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" xmlns:atr="atr" xmlns:atrsz="atrsz" xmlns:cmn="cmn" xmlns:gml="http://www.opengis.net/gml/3.2" targetNamespace="ohzbod" xmlns:ohzbod="ohzbod">
  <xs:import schemaLocation="../common/atributy.xsd" namespace="atr"/>
  <xs:import schemaLocation="../common/atributy_sz.xsd" namespace="atrsz"/>
  <xs:import schemaLocation="../common/common.xsd" namespace="cmn"/>
  <xs:import schemaLocation="../ext/gml/gml.xsd" namespace="http://www.opengis.net/gml/3.2"/>
  <xs:element name="OdpadoveHospodarstviZamerBod" type="ohzbod:OdpadoveHospodarstviZamerBodType"/>
  <xs:complexType name="OdpadoveHospodarstviZamerBodType">
    <xs:sequence>
      <xs:element name="ObjektovyKod" type="xs:string" fixed="537"/>
      <xs:element name="ObjektovyTypNazev" fixed="odpadové hospodářství - záměr">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="code_base" type="xs:string" fixed="0100000364" use="required"/>
              <xs:attribute name="code_suffix" type="xs:string" fixed="01" use="required"/>
              <xs:attribute name="dim" type="xs:integer" fixed="2" use="prohibited"/>
              <xs:attribute name="gia" type="xs:boolean" fixed="0" use="prohibited"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
      <xs:sequence>
        <xs:element name="KategorieObjektu" type="xs:string" fixed="Záměry na provedení změn dopravní a technické infrastruktury">
          <xs:annotation>
            <xs:documentation>Kategorie objektu dle Vyhlášky o DTM kraje</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="SkupinaObjektu" type="xs:string" fixed="Záměr na provedení změn dopravní a technické infrastruktury">
          <xs:annotation>
            <xs:documentation>Skupina objektu dle Vyhlášky o DTM kraje</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ObsahovaCast" type="xs:string" fixed="TI">
          <xs:annotation>
            <xs:documentation>Zařazení objektu do obsahové části dle Vyhlášky o DTM kraje</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ZaznamyObjektu">
          <xs:annotation>
            <xs:documentation>Jednotlivé záznamy daného objektu</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="ohzbod:ZaznamObjektu" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ZaznamObjektu" abstract="true"/>
  <xs:element name="ZaznamObjektuRefV" type="ohzbod:RefV" substitutionGroup="ohzbod:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuRefN" type="ohzbod:RefN" substitutionGroup="ohzbod:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuIns" type="ohzbod:Ins" substitutionGroup="ohzbod:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuUpd" type="ohzbod:Upd" substitutionGroup="ohzbod:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuDel" type="ohzbod:Del" substitutionGroup="ohzbod:ZaznamObjektu"/>
  <xs:complexType name="RefV">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuRefVType"/>
            <xs:element name="SpolecneAtributyObjektuZameru" type="atr:SpolecneAtributyObjektuZameruRefVType"/>
            <xs:element ref="atr:TypObjektuOdpadovehoHospodarstviZameru" minOccurs="0"/>
            <xs:element ref="atrsz:Natoceni"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuBod2DType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RefN">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuRefNType"/>
            <xs:element name="SpolecneAtributyObjektuZameru" type="atr:SpolecneAtributyObjektuZameruRefNType"/>
            <xs:element ref="atr:TypObjektuOdpadovehoHospodarstviZameru" minOccurs="0"/>
            <xs:element ref="atrsz:Natoceni"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuBod2DType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Ins">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuInsType" minOccurs="0"/>
            <xs:element name="SpolecneAtributyObjektuZameru" type="atr:SpolecneAtributyObjektuZameruInsType"/>
            <xs:element ref="atr:TypObjektuOdpadovehoHospodarstviZameru"/>
            <xs:element ref="atrsz:Natoceni"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuBod2DType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Upd">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuUpdType"/>
            <xs:element name="SpolecneAtributyObjektuZameru" type="atr:SpolecneAtributyObjektuZameruUpdType" minOccurs="0"/>
            <xs:element ref="atr:TypObjektuOdpadovehoHospodarstviZameru" minOccurs="0"/>
            <xs:element ref="atrsz:Natoceni" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuBod2DType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Del">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuDelType"/>
            <xs:element name="SpolecneAtributyObjektuZameru" type="atr:SpolecneAtributyObjektuZameruDelType" minOccurs="0"/>
            <xs:element ref="atr:TypObjektuOdpadovehoHospodarstviZameru" minOccurs="0"/>
            <xs:element ref="atrsz:Natoceni" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuBod2DType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
