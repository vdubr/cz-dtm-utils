<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" xmlns:atr="atr" xmlns:atrsz="atrsz" xmlns:cmn="cmn" xmlns:gml="http://www.opengis.net/gml/3.2" targetNamespace="tpplin" xmlns:tpplin="tpplin">
  <xs:import schemaLocation="../common/atributy.xsd" namespace="atr"/>
  <xs:import schemaLocation="../common/atributy_sz.xsd" namespace="atrsz"/>
  <xs:import schemaLocation="../common/common.xsd" namespace="cmn"/>
  <xs:import schemaLocation="../ext/gml/gml.xsd" namespace="http://www.opengis.net/gml/3.2"/>
  <xs:element name="TrasaPlynovodniPripojky" type="tpplin:TrasaPlynovodniPripojkyType"/>
  <xs:complexType name="TrasaPlynovodniPripojkyType">
    <xs:sequence>
      <xs:element name="ObjektovyKod" type="xs:string" fixed="466"/>
      <xs:element name="ObjektovyTypNazev" fixed="trasa plynovodní přípojky">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="code_base" type="xs:string" fixed="0100000328" use="required"/>
              <xs:attribute name="code_suffix" type="xs:string" fixed="02" use="required"/>
              <xs:attribute name="dim" type="xs:integer" fixed="3" use="prohibited"/>
              <xs:attribute name="gia" type="xs:boolean" fixed="1" use="prohibited"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
      <xs:sequence>
        <xs:element name="KategorieObjektu" type="xs:string" fixed="Stavby technické infrastruktury">
          <xs:annotation>
            <xs:documentation>Kategorie objektu dle Vyhlášky o DTM kraje</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="SkupinaObjektu" type="xs:string" fixed="Plynovod">
          <xs:annotation>
            <xs:documentation>Skupina objektu dle Vyhlášky o DTM kraje</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ObsahovaCast" type="xs:string" fixed="TI">
          <xs:annotation>
            <xs:documentation>Zařazení objektu do obsahové části dle Vyhlášky o DTM kraje</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ZaznamyObjektu">
          <xs:annotation>
            <xs:documentation>Jednotlivé záznamy daného objektu</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="tpplin:ZaznamObjektu" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ZaznamObjektu" abstract="true"/>
  <xs:element name="ZaznamObjektuRefV" type="tpplin:RefV" substitutionGroup="tpplin:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuRefN" type="tpplin:RefN" substitutionGroup="tpplin:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuIns" type="tpplin:Ins" substitutionGroup="tpplin:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuUpd" type="tpplin:Upd" substitutionGroup="tpplin:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuDel" type="tpplin:Del" substitutionGroup="tpplin:ZaznamObjektu"/>
  <xs:complexType name="RefV">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuRefVType"/>
            <xs:element name="SpolecneAtributyObjektuTISZ" type="atrsz:SpolecneAtributyObjektuTISZRefVType" minOccurs="0"/>
            <xs:element name="SpolecneAtributyObjektuTI" type="atr:SpolecneAtributyObjektuTIRefVType"/>
            <xs:element ref="atr:StavTrasySiteTI"/>
            <xs:element ref="atr:VedeniSiteVJineStavbe"/>
            <xs:element ref="atr:TlakovaHladinaPlynovodniSite"/>
            <xs:element ref="atr:Dimenze"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuLinie3DType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RefN">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuRefNType"/>
            <xs:element name="SpolecneAtributyObjektuTISZ" type="atrsz:SpolecneAtributyObjektuTISZRefNType"/>
            <xs:element name="SpolecneAtributyObjektuTI" type="atr:SpolecneAtributyObjektuTIRefNType"/>
            <xs:element ref="atr:StavTrasySiteTI"/>
            <xs:element ref="atr:VedeniSiteVJineStavbe"/>
            <xs:element ref="atr:TlakovaHladinaPlynovodniSite"/>
            <xs:element ref="atr:Dimenze"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuLinie3DType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Ins">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuInsType" minOccurs="0"/>
            <xs:element name="SpolecneAtributyObjektuTISZ" type="atrsz:SpolecneAtributyObjektuTISZInsType"/>
            <xs:element name="SpolecneAtributyObjektuTI" type="atr:SpolecneAtributyObjektuTIInsType"/>
            <xs:element ref="atr:StavTrasySiteTI"/>
            <xs:element ref="atr:VedeniSiteVJineStavbe"/>
            <xs:element ref="atr:TlakovaHladinaPlynovodniSite"/>
            <xs:element ref="atr:Dimenze"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuLinie3DType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Upd">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuUpdType"/>
            <xs:element name="SpolecneAtributyObjektuTISZ" type="atrsz:SpolecneAtributyObjektuTISZUpdType" minOccurs="0"/>
            <xs:element name="SpolecneAtributyObjektuTI" type="atr:SpolecneAtributyObjektuTIUpdType" minOccurs="0"/>
            <xs:element ref="atr:StavTrasySiteTI" minOccurs="0"/>
            <xs:element ref="atr:VedeniSiteVJineStavbe" minOccurs="0"/>
            <xs:element ref="atr:TlakovaHladinaPlynovodniSite" minOccurs="0"/>
            <xs:element ref="atr:Dimenze" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuLinie3DType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Del">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuDelType"/>
            <xs:element name="SpolecneAtributyObjektuTISZ" type="atrsz:SpolecneAtributyObjektuTISZDelType" minOccurs="0"/>
            <xs:element name="SpolecneAtributyObjektuTI" type="atr:SpolecneAtributyObjektuTIDelType" minOccurs="0"/>
            <xs:element ref="atr:StavTrasySiteTI" minOccurs="0"/>
            <xs:element ref="atr:VedeniSiteVJineStavbe" minOccurs="0"/>
            <xs:element ref="atr:TlakovaHladinaPlynovodniSite" minOccurs="0"/>
            <xs:element ref="atr:Dimenze" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuLinie3DType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
