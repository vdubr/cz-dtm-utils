<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" xmlns:atr="atr" xmlns:atrsz="atrsz" xmlns:cmn="cmn" xmlns:gml="http://www.opengis.net/gml/3.2" targetNamespace="noteza" xmlns:noteza="noteza">
  <xs:import schemaLocation="../common/atributy.xsd" namespace="atr"/>
  <xs:import schemaLocation="../common/atributy_sz.xsd" namespace="atrsz"/>
  <xs:import schemaLocation="../common/common.xsd" namespace="cmn"/>
  <xs:import schemaLocation="../ext/gml/gml.xsd" namespace="http://www.opengis.net/gml/3.2"/>
  <xs:element name="NosicTechnickehoZarizeni" type="noteza:NosicTechnickehoZarizeniType"/>
  <xs:complexType name="NosicTechnickehoZarizeniType">
    <xs:sequence>
      <xs:element name="ObjektovyKod" type="xs:string" fixed="201"/>
      <xs:element name="ObjektovyTypNazev" fixed="nosič technického zařízení">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="code_base" type="xs:string" fixed="0100000201" use="required"/>
              <xs:attribute name="code_suffix" type="xs:string" fixed="01" use="required"/>
              <xs:attribute name="dim" type="xs:integer" fixed="3" use="prohibited"/>
              <xs:attribute name="gia" type="xs:boolean" fixed="0" use="prohibited"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
      <xs:sequence>
        <xs:element name="KategorieObjektu" type="xs:string" fixed="Součásti a příslušenství staveb">
          <xs:annotation>
            <xs:documentation>Kategorie objektu dle Vyhlášky o DTM kraje</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="SkupinaObjektu" type="xs:string" fixed="Zařízení staveb">
          <xs:annotation>
            <xs:documentation>Skupina objektu dle Vyhlášky o DTM kraje</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ObsahovaCast" type="xs:string" fixed="ZPS">
          <xs:annotation>
            <xs:documentation>Zařazení objektu do obsahové části dle Vyhlášky o DTM kraje</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ZaznamyObjektu">
          <xs:annotation>
            <xs:documentation>Jednotlivé záznamy daného objektu</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="noteza:ZaznamObjektu" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ZaznamObjektu" abstract="true"/>
  <xs:element name="ZaznamObjektuRefV" type="noteza:RefV" substitutionGroup="noteza:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuRefN" type="noteza:RefN" substitutionGroup="noteza:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuIns" type="noteza:Ins" substitutionGroup="noteza:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuUpd" type="noteza:Upd" substitutionGroup="noteza:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuDel" type="noteza:Del" substitutionGroup="noteza:ZaznamObjektu"/>
  <xs:complexType name="RefV">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuRefVType"/>
            <xs:element name="SpolecneAtributyObjektuZPS" type="atr:SpolecneAtributyObjektuZPSRefVType"/>
            <xs:element name="SpolecneAtributyObjektuZPSSZ" type="atrsz:SpolecneAtributyObjektuZPSSZRefVType"/>
            <xs:element ref="atr:TypNosiceTechnickehoZarizeni"/>
            <xs:element ref="atr:ZpusobPorizeniZPS"/>
            <xs:element ref="atrsz:Natoceni" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuBod3DType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RefN">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuRefNType"/>
            <xs:element name="SpolecneAtributyObjektuZPS" type="atr:SpolecneAtributyObjektuZPSRefNType"/>
            <xs:element name="SpolecneAtributyObjektuZPSSZ" type="atrsz:SpolecneAtributyObjektuZPSSZRefNType" minOccurs="0"/>
            <xs:element ref="atr:TypNosiceTechnickehoZarizeni"/>
            <xs:element ref="atr:ZpusobPorizeniZPS"/>
            <xs:element ref="atrsz:Natoceni" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuBod3DType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Ins">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuInsType" minOccurs="0"/>
            <xs:element name="SpolecneAtributyObjektuZPS" type="atr:SpolecneAtributyObjektuZPSInsType"/>
            <xs:element name="SpolecneAtributyObjektuZPSSZ" type="atrsz:SpolecneAtributyObjektuZPSSZInsType"/>
            <xs:element ref="atr:TypNosiceTechnickehoZarizeni"/>
            <xs:element ref="atr:ZpusobPorizeniZPS"/>
            <xs:element ref="atrsz:Natoceni"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuBod3DType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Upd">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuUpdType"/>
            <xs:element name="SpolecneAtributyObjektuZPS" type="atr:SpolecneAtributyObjektuZPSUpdType" minOccurs="0"/>
            <xs:element name="SpolecneAtributyObjektuZPSSZ" type="atrsz:SpolecneAtributyObjektuZPSSZUpdType" minOccurs="0"/>
            <xs:element ref="atr:TypNosiceTechnickehoZarizeni" minOccurs="0"/>
            <xs:element ref="atr:ZpusobPorizeniZPS" minOccurs="0"/>
            <xs:element ref="atrsz:Natoceni" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuBod3DType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Del">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuDelType"/>
            <xs:element name="SpolecneAtributyObjektuZPS" type="atr:SpolecneAtributyObjektuZPSDelType" minOccurs="0"/>
            <xs:element name="SpolecneAtributyObjektuZPSSZ" type="atrsz:SpolecneAtributyObjektuZPSSZDelType" minOccurs="0"/>
            <xs:element ref="atr:TypNosiceTechnickehoZarizeni" minOccurs="0"/>
            <xs:element ref="atr:ZpusobPorizeniZPS" minOccurs="0"/>
            <xs:element ref="atrsz:Natoceni" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuBod3DType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
