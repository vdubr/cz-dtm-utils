<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" xmlns:atr="atr" xmlns:atrsz="atrsz" xmlns:cmn="cmn" xmlns:gml="http://www.opengis.net/gml/3.2" targetNamespace="pptpol" xmlns:pptpol="pptpol">
  <xs:import schemaLocation="../common/atributy.xsd" namespace="atr"/>
  <xs:import schemaLocation="../common/atributy_sz.xsd" namespace="atrsz"/>
  <xs:import schemaLocation="../common/common.xsd" namespace="cmn"/>
  <xs:import schemaLocation="../ext/gml/gml.xsd" namespace="http://www.opengis.net/gml/3.2"/>
  <xs:element name="ProvozniPlochaTuneluPlocha" type="pptpol:ProvozniPlochaTuneluPlochaType"/>
  <xs:complexType name="ProvozniPlochaTuneluPlochaType">
    <xs:sequence>
      <xs:element name="ObjektovyKod" type="xs:string" fixed="62"/>
      <xs:element name="ObjektovyTypNazev" fixed="provozní plocha tunelu">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="code_base" type="xs:string" fixed="0100000062" use="required"/>
              <xs:attribute name="code_suffix" type="xs:string" fixed="03" use="required"/>
              <xs:attribute name="dim" type="xs:integer" fixed="3" use="prohibited"/>
              <xs:attribute name="gia" type="xs:boolean" fixed="0" use="prohibited"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
      <xs:sequence>
        <xs:element name="KategorieObjektu" type="xs:string" fixed="Dopravní stavby">
          <xs:annotation>
            <xs:documentation>Kategorie objektu dle Vyhlášky o DTM kraje</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="SkupinaObjektu" type="xs:string" fixed="Dopravní stavba společná pro více skupin">
          <xs:annotation>
            <xs:documentation>Skupina objektu dle Vyhlášky o DTM kraje</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ObsahovaCast" type="xs:string" fixed="ZPS">
          <xs:annotation>
            <xs:documentation>Zařazení objektu do obsahové části dle Vyhlášky o DTM kraje</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ZaznamyObjektu">
          <xs:annotation>
            <xs:documentation>Jednotlivé záznamy daného objektu</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="pptpol:ZaznamObjektu" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ZaznamObjektu" abstract="true"/>
  <xs:element name="ZaznamObjektuRefV" type="pptpol:RefV" substitutionGroup="pptpol:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuRefN" type="pptpol:RefN" substitutionGroup="pptpol:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuIns" type="pptpol:Ins" substitutionGroup="pptpol:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuUpd" type="pptpol:Upd" substitutionGroup="pptpol:ZaznamObjektu"/>
  <xs:element name="ZaznamObjektuDel" type="pptpol:Del" substitutionGroup="pptpol:ZaznamObjektu"/>
  <xs:complexType name="RefV">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuRefVType"/>
            <xs:element name="SpolecneAtributyObjektuZPS" type="atr:SpolecneAtributyObjektuZPSRefVType"/>
            <xs:element name="SpolecneAtributyObjektuZPSSZ" type="atrsz:SpolecneAtributyObjektuZPSSZRefVType"/>
            <xs:element ref="atrsz:EvidencniKilometraz" minOccurs="0"/>
            <xs:element ref="atrsz:NerozlisenaKilometraz" minOccurs="0"/>
            <xs:element ref="atr:TypTunelu"/>
            <xs:element ref="atrsz:EvidencniCisloTunelu" minOccurs="0"/>
            <xs:element ref="atrsz:PopisTunelu" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuPlochaZPSType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RefN">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuRefNType"/>
            <xs:element name="SpolecneAtributyObjektuZPS" type="atr:SpolecneAtributyObjektuZPSRefNType"/>
            <xs:element name="SpolecneAtributyObjektuZPSSZ" type="atrsz:SpolecneAtributyObjektuZPSSZRefNType" minOccurs="0"/>
            <xs:element ref="atrsz:EvidencniKilometraz" minOccurs="0"/>
            <xs:element ref="atrsz:NerozlisenaKilometraz" minOccurs="0"/>
            <xs:element ref="atr:TypTunelu"/>
            <xs:element ref="atrsz:EvidencniCisloTunelu" minOccurs="0"/>
            <xs:element ref="atrsz:PopisTunelu" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuPlochaZPSType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Ins">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuInsType" minOccurs="0"/>
            <xs:element name="SpolecneAtributyObjektuZPS" type="atr:SpolecneAtributyObjektuZPSInsType"/>
            <xs:element name="SpolecneAtributyObjektuZPSSZ" type="atrsz:SpolecneAtributyObjektuZPSSZInsType"/>
            <xs:element ref="atrsz:EvidencniKilometraz"/>
            <xs:element ref="atrsz:NerozlisenaKilometraz" minOccurs="0"/>
            <xs:element ref="atr:TypTunelu"/>
            <xs:element ref="atrsz:EvidencniCisloTunelu" minOccurs="0"/>
            <xs:element ref="atrsz:PopisTunelu" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuPlochaZPSType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Upd">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuUpdType"/>
            <xs:element name="SpolecneAtributyObjektuZPS" type="atr:SpolecneAtributyObjektuZPSUpdType" minOccurs="0"/>
            <xs:element name="SpolecneAtributyObjektuZPSSZ" type="atrsz:SpolecneAtributyObjektuZPSSZUpdType" minOccurs="0"/>
            <xs:element ref="atrsz:EvidencniKilometraz" minOccurs="0"/>
            <xs:element ref="atrsz:NerozlisenaKilometraz" minOccurs="0"/>
            <xs:element ref="atr:TypTunelu" minOccurs="0"/>
            <xs:element ref="atrsz:EvidencniCisloTunelu" minOccurs="0"/>
            <xs:element ref="atrsz:PopisTunelu" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuPlochaZPSType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Del">
    <xs:sequence>
      <xs:element name="AtributyObjektu">
        <xs:complexType>
          <xs:all>
            <xs:element name="SpolecneAtributyVsechObjektu" type="atr:SpolecneAtributyVsechObjektuDelType"/>
            <xs:element name="SpolecneAtributyObjektuZPS" type="atr:SpolecneAtributyObjektuZPSDelType" minOccurs="0"/>
            <xs:element name="SpolecneAtributyObjektuZPSSZ" type="atrsz:SpolecneAtributyObjektuZPSSZDelType" minOccurs="0"/>
            <xs:element ref="atrsz:EvidencniKilometraz" minOccurs="0"/>
            <xs:element ref="atrsz:NerozlisenaKilometraz" minOccurs="0"/>
            <xs:element ref="atr:TypTunelu" minOccurs="0"/>
            <xs:element ref="atrsz:EvidencniCisloTunelu" minOccurs="0"/>
            <xs:element ref="atrsz:PopisTunelu" minOccurs="0"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="GeometrieObjektu" type="cmn:GeometrieObjektuPlochaZPSType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
