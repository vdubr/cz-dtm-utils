<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="dopinf" xmlns="dopinf" xmlns:dopinf="dopinf" xmlns:atr="atr" xmlns:objtyp="objtyp" xmlns:gml="http://www.opengis.net/gml/3.2">
  <xs:import schemaLocation="../common/atributy.xsd" namespace="atr"/>
  <xs:import schemaLocation="../ext/gml/gml.xsd" namespace="http://www.opengis.net/gml/3.2"/>

  <xs:element name="DoprovodneInformace" abstract="true"/>
  <xs:element name="DoprovodneInformaceZXMLGAD" type="DoprovodneInformaceZXMLGADType" substitutionGroup="DoprovodneInformace"/>
  <xs:element name="DoprovodneInformaceZXMLVydej" type="DoprovodneInformaceZXMLVydejType" substitutionGroup="DoprovodneInformace"/>

  <!--  Typy pro DoprovodneInformace   -->
  <xs:complexType name="DoprovodneInformaceZXMLGADType">
    <xs:sequence>
      <xs:element name="UdajeOZmenach">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="ZaznamZmeny" type="ZaznamZmenyZXMLGADType"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="IdentifikacniCislaStaveb" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element ref="ZaznamICS" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="OblastiKompletniZPS" minOccurs="0"> <!-- zmena povinnosti v ZXML, pridano minOccurs="0" -->
        <xs:complexType>
          <xs:sequence>
            <xs:element name="ZaznamOKZPS" type="ZaznamOKZPSGADType" maxOccurs="unbounded"/> <!-- zrusena vlastnost nillable -->
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DoprovodneInformaceZXMLVydejType">
    <xs:sequence>
      <xs:element name="UdajeOZmenach">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="ZaznamZmeny" type="ZaznamZmenyZXMLVydejType" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="IdentifikacniCislaStaveb" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element ref="ZaznamICS" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="OblastiKompletniZPS">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="ZaznamOKZPS" type="ZaznamOKZPSVydejZPSType" maxOccurs="unbounded" nillable="true"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="UdajeOVydeji" type="UdajeOVydejiType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="UdajeOVydejiType">
    <xs:annotation>
      <xs:documentation>=Udaje o výdeji datové sady</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element ref="DatumPlatnosti"/>
      <xs:element ref="TypDatoveSady"/>
      <xs:element ref="PopisDatoveSady" minOccurs="0"/>
      <xs:element ref="ObvodDatoveSady" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!--  Typy pro ZaznamZmeny   -->

  <xs:complexType name="ZaznamZmenyZXMLGADType">
    <xs:sequence>
      <xs:element ref="atr:IDZmenyZpracovatele" minOccurs="0"/>
      <xs:element ref="atr:PopisObjektu" minOccurs="0"/>
      <xs:element ref="NazevZakazky"/>
      <xs:element ref="CisloStavbyZakazky" minOccurs="0"/>
      <xs:element ref="PartnerInvestor" minOccurs="0"/>
      <xs:element ref="Zpracovatel"/>
      <xs:element ref="OrganizaceZpracovatele"/>
      <xs:element ref="DatumMereni"/>
      <xs:element ref="DatumZpracovani"/>
      <xs:element ref="AZI"/>
      <xs:element ref="DatumOvereni"/>
      <xs:element ref="CisloOvereni"/>
      <xs:element ref="OblastZmeny" maxOccurs="unbounded"/>
      <xs:element ref="Konsolidace"/> <!-- pro ZXML povinne oproti JVF --> 
    </xs:sequence>
  </xs:complexType>

 <xs:complexType name="ZaznamZmenyZXMLVydejType">
    <xs:all>
      <xs:element ref="atr:IDPodani"/>
      <xs:element ref="atr:IDZmenyZpracovatele" minOccurs="0"/>
      <xs:element ref="atr:PopisObjektu" minOccurs="0"/>
      <xs:element ref="atr:IDEditora" minOccurs="0"/>
      <xs:element ref="atr:DatumVkladu" minOccurs="0"/>
      <xs:element ref="atr:VkladOsoba" minOccurs="0"/>
      <xs:element ref="NazevZakazky" minOccurs="0"/>
      <xs:element ref="CisloStavbyZakazky" minOccurs="0"/>
      <xs:element ref="PartnerInvestor" minOccurs="0"/>
      <xs:element ref="Zpracovatel" minOccurs="0"/>
      <xs:element ref="OrganizaceZpracovatele" minOccurs="0"/>
      <xs:element ref="DatumMereni" minOccurs="0"/>
      <xs:element ref="DatumZpracovani" minOccurs="0"/>
      <xs:element ref="AZI" minOccurs="0"/>
      <xs:element ref="DatumOvereni" minOccurs="0"/>
      <xs:element ref="CisloOvereni" minOccurs="0"/>
      <xs:element ref="OblastZmeny" minOccurs="0"/>
      <xs:element ref="Konsolidace" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:element name="DatumPlatnosti" type="xs:dateTime">
    <xs:annotation>
      <xs:documentation>Soubor obsahuje data DTM platná k tomuto datumu</xs:documentation>
    </xs:annotation>
  </xs:element>

  <xs:element name="TypDatoveSady">
    <xs:annotation>
      <xs:documentation>Určení typu datové sady</xs:documentation>
    </xs:annotation>
    <xs:simpleType>
      <xs:restriction base="xs:integer">
        <xs:enumeration value="1">
          <xs:annotation>
            <xs:documentation>ZPS - podrobné body</xs:documentation>
          </xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="2">
          <xs:annotation>
            <xs:documentation>ZPS - odvozené plošné typy objektů</xs:documentation>
          </xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="3">
          <xs:annotation>
            <xs:documentation>ZPS s výjimkou podrobných bodů a odvozených plošných typů objektů a včetně konstrukčních objektů</xs:documentation>
          </xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="4">
          <xs:annotation>
            <xs:documentation>doprovodné informace k území</xs:documentation>
          </xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="6">
          <xs:annotation>
            <xs:documentation>TI - veřejná i neveřejná část (kompletní výpis) a doprovodné informace k území</xs:documentation>
          </xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="7">
          <xs:annotation>
            <xs:documentation>DI - veřejná část a doprovodné informace k území</xs:documentation>
          </xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="8">
          <xs:annotation>
            <xs:documentation>DI - veřejná i neveřejná část (kompletní výpis) a doprovodné informace k území</xs:documentation>
          </xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="9">
          <xs:annotation>
            <xs:documentation>ZPS - kompletní výpis a doprovodné informace k území (pouze pro ad hoc výdej)</xs:documentation>
          </xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="10">
          <xs:annotation>
            <xs:documentation>výdej vlastních dat VSP</xs:documentation>
          </xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="11">
          <xs:annotation>
            <xs:documentation>PSPI - veřejná část a doprovodné informace k území</xs:documentation>
          </xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="12">
          <xs:annotation>
            <xs:documentation>PSPI - veřejná i neveřejná část (kompletní výpis) a doprovodné informace k území</xs:documentation>
          </xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="13">
          <xs:annotation>
            <xs:documentation>PSPI - výdej vlastních dat BS</xs:documentation>
          </xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="60">
          <xs:annotation>
            <xs:documentation>Kombinovaný výdej ŽXML</xs:documentation><!-- pridan novy typ datove sady pro ZXML -->
          </xs:annotation>
        </xs:enumeration>    
      </xs:restriction>
    </xs:simpleType>
  </xs:element>

  <xs:element name="PopisDatoveSady" type="atr:Text1000">
    <xs:annotation>
      <xs:documentation>Volitelný popis datové sady (např. název obce)</xs:documentation>
    </xs:annotation>
  </xs:element>

  <xs:element name="ObvodDatoveSady">
    <xs:annotation>
      <xs:documentation>Volitelný obvod datové sady (např. pro ad hoc výdeje)</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="gml:Polygon"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="ZaznamVSP">
    <xs:complexType>
      <xs:all>
        <xs:element ref="IDVSP"/>
        <xs:element ref="NazevVSP"/>
        <xs:element ref="IdentifikacniCisloVSP"/>
      </xs:all>
    </xs:complexType>
  </xs:element>

  <xs:element name="ZaznamBS">
    <xs:complexType>
      <xs:all>
        <xs:element ref="atr:IDBS"/>
        <xs:element ref="NazevBS"/>
        <xs:element ref="IdentifikacniCisloBS" minOccurs="0"/>
      </xs:all>
    </xs:complexType>
  </xs:element>

  <xs:element name="ZaznamICS">
    <xs:complexType>
      <xs:all>
        <xs:element ref="atr:ICS"/>
        <xs:element name="ObjektyDTM" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="IDZaznamuObjektuDTM" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:all>
    </xs:complexType>
  </xs:element>

  <xs:element name="NazevZakazky" type="atr:Text255"/>
  <xs:element name="CisloStavbyZakazky" type="atr:Text255"/>
  <xs:element name="PartnerInvestor" type="atr:Text255"/>
  <xs:element name="Zpracovatel" type="atr:Text255"/>
  <xs:element name="OrganizaceZpracovatele" type="atr:Text255"/>
  <xs:element name="DatumMereni" type="xs:date"/>
  <xs:element name="DatumZpracovani" type="xs:date"/>
  <xs:element name="AZI" type="atr:Text25">
    <xs:annotation>
      <xs:documentation>Číslo oprávnění autorizovaného zeměměřického inženýra (dříve ÚOZI)</xs:documentation>
      <xs:documentation>Povinný pro geodetickou aktualizační dokumentaci (GAD), nepovinný pro krajskou aktualizační dokumentaci (KAD)</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="DatumOvereni" type="xs:date"/>
  <xs:element name="CisloOvereni" type="atr:Text25"/>

  <xs:element name="OblastZmeny">
    <xs:annotation>
      <xs:documentation>Vymezení oblasti, uvnitř níž se nacházejí objekty změny</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="gml:surfaceProperty"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="Konsolidace" type="xs:boolean" nillable="true">
    <xs:annotation>
      <xs:documentation>Jedná se o import konsolidovaných dat?</xs:documentation>
      <xs:documentation>1 = ano, 0 = ne</xs:documentation>
    </xs:annotation>
  </xs:element>

  <xs:complexType name="ZaznamOKZPSGADType">
    <xs:annotation>
      <xs:documentation>Záznam oblasti kompletní ZPS</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element ref="atr:UrovenUmisteniObjektuZPS"/>
      <xs:element name="TypZaznamuOKZPS" type="TypZaznamuOKZPSType"/>
      <xs:element ref="GeometrieObjektu"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ZaznamOKZPSVydejZPSType">
    <xs:annotation>
      <xs:documentation>Záznam oblasti kompletní ZPS</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element ref="atr:UrovenUmisteniObjektuZPS"/>
      <xs:element name="TypZaznamuOKZPS" type="TypZaznamuOKVydejZPSType"/>
      <xs:element ref="GeometrieObjektu"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="GeometrieObjektu">
    <xs:annotation>
      <xs:documentation>Oblasti kompletní ZPS mohou obsahovat otvory</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="PlochaZPS">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="gml:surfaceProperty"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:simpleType name="TypZaznamuOKZPSType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="NEW"/>
      <xs:enumeration value="DEL"/>
	  <xs:enumeration value="DTMŽ-FINAL"/> <!-- rozsireni enumerace pro ZXML-->
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TypZaznamuOKVydejZPSType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="REF"/>
      <xs:enumeration value="DTMŽ"/> <!-- rozsireni enumerace pro ZXML-->
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="IDVSP" type="atr:Text50">
    <xs:annotation>
      <xs:documentation>Identifikátor vlastníka/správce/provozovatele v IS DMVS</xs:documentation>
    </xs:annotation>
  </xs:element>

  <xs:element name="NazevVSP" type="atr:Text255">
    <xs:annotation>
      <xs:documentation>Název vlastníka/správce/provozovatele v IS DMVS</xs:documentation>
    </xs:annotation>
  </xs:element>

  <xs:element name="IdentifikacniCisloVSP" type="atr:Text25">
    <xs:annotation>
      <xs:documentation>IČO vlastníka/správce/provozovatele v IS DMVS</xs:documentation>
    </xs:annotation>
  </xs:element>

  <xs:element name="NazevBS" type="atr:Text255">
    <xs:annotation>
      <xs:documentation>Název budoucího stavebníka v IS DMVS</xs:documentation>
    </xs:annotation>
  </xs:element>

  <xs:element name="IdentifikacniCisloBS" type="atr:Text25">
    <xs:annotation>
      <xs:documentation>IČO budoucího stavebníka v IS DMVS</xs:documentation>
    </xs:annotation>
  </xs:element>

  <xs:element name="IDZaznamuObjektuDTM" type="atr:Text100"/>

</xs:schema>
