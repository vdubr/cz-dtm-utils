<?xml version="1.0" encoding="UTF-8"?>
<xs:schema elementFormDefault="qualified" xmlns:atr="atr" xmlns:atrsz="atrsz" xmlns:cmn="cmn" xmlns:gml="http://www.opengis.net/gml/3.2" targetNamespace="sklbod" xmlns:sklbod="sklbod" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:import schemaLocation="../common/atributy.xsd" namespace="atr"/>
  <xs:import schemaLocation="../common/atributy_sz.xsd" namespace="atrsz"/>
  <xs:import schemaLocation="../common/common.xsd" namespace="cmn"/>
  <xs:import schemaLocation="../ext/gml/gml.xsd" namespace="http://www.opengis.net/gml/3.2"/>
  <xs:element name="SklepBod" type="sklbod:SklepBodType"/>
  <xs:complexType name="SklepBodType">
    <xs:sequence>
      <xs:element name="ObjektovyTypNazev" fixed="Sklep - bod">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="code_base" type="xs:string" fixed="9990000582" use="required"/>
              <xs:attribute name="code_suffix" type="xs:string" fixed="01" use="required"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
      <xs:sequence>
        <xs:element name="KategorieObjektu" type="xs:string" fixed="Konsolidace dat">
          <xs:annotation>
            <xs:documentation>Kategorie objektu dle metodiky SŽ</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="SkupinaObjektu" type="xs:string" fixed="Sklep">
          <xs:annotation>
            <xs:documentation>Skupina objektu dle metodiky SŽ</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ObsahovaCast" type="xs:string" fixed="SKLEP">
          <xs:annotation>
            <xs:documentation>Zařazení objektu do obsahové části dle metodiky SŽ</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ZaznamyObjektu">
          <xs:annotation>
            <xs:documentation>Jednotlivé záznamy daného objektu</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="ZaznamObjektu" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element ref="cmn:ZapisObjektu"/>
                    <xs:element name="AtributyObjektu">
                      <xs:complexType>
                        <xs:all>
                          <xs:element ref="atr:SpolecneAtributyVsechObjektu"/>
                          <xs:element ref="atr:SpolecneAtributyObjektuZPS"/>
                          <xs:element ref="atrsz:KonsolidacniText" minOccurs="0"/>
                          <xs:element ref="atrsz:CisStaOb" minOccurs="0"/>
                          <xs:element ref="atrsz:NazStaOb" minOccurs="0"/>
                          <xs:element ref="atrsz:Natoceni" minOccurs="0"/>
                          <xs:element ref="atrsz:PrvekM20ZKonsolidace" minOccurs="0"/>
                        </xs:all>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="GeometrieObjektu">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element ref="gml:pointProperty"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
