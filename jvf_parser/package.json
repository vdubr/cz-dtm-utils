{
  "name": "jvf-parser",
  "version": "2026.8.25",
  "description": "TypeScript parser for JVF DTM (Jednotný Výměnný Formát - Digital Technical Map) format",
  "license": "MIT",
  "author": "Vojtěch Dubrovský",
  "repository": {
    "type": "git",
    "url": "https://github.com/vdubr/cz-dtm-utils.git",
    "directory": "jvf_parser"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate": "tsx scripts/generate-types.ts",
    "generate:1501": "tsx scripts/generate-types.ts 1.5.0.1",
    "generate:1502": "tsx scripts/generate-types.ts 1.5.0.2",
    "generate:udm": "tsx scripts/generate-types.ts udm-2.1.1",
    "generate:zxml1421": "tsx scripts/generate-types.ts zxml-1.4.2.1",
    "generate:zxml1516": "tsx scripts/generate-types.ts zxml-1.5.1.6",
    "generate:all": "npm run generate && npm run generate:1501 && npm run generate:1502 && npm run generate:udm && npm run generate:zxml1421 && npm run generate:zxml1516"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "fast-xml-parser": "^4.3.0",
    "jvf-dtm-types": "file:../jvf_dtm_types"
  }
}
